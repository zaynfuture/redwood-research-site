# Paste these values into Streamlit Community Cloud > App settings > Secrets.
REDWOOD_API_BASE_URL = "https://private-api.cortexhubs.com"
REDWOOD_API_SERVICE_TOKEN = "replace-with-a-long-random-secret"
REDWOOD_API_DOCS_URL = "https://private-api.cortexhubs.com/docs"
STRIPE_PAYMENT_LINK = "https://buy.stripe.com/replace-me"
AUTH_ENABLED = true
# Fail closed by default: comma-separated paid/test accounts. Replace with a billing-backed
# entitlement service before opening self-service subscriptions broadly.
REDWOOD_AUTHORIZED_EMAILS = "owner@example.com,tester@example.com"
ALLOW_ALL_AUTHENTICATED_USERS = false

# Native Streamlit OIDC configuration for Google sign-in.
[auth]
redirect_uri = "https://your-app.streamlit.app/oauth2callback"
cookie_secret = "replace-with-a-long-random-cookie-secret"
client_id = "replace.apps.googleusercontent.com"
client_secret = "replace-with-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
