{
  "name": "Domain redirects",
  "rules": [
    {
      "ref": "cortexhubs_apex_to_redwood",
      "description": "Redirect cortexhubs.com and www to Redwood Research",
      "expression": "(http.host eq \"cortexhubs.com\") or (http.host eq \"www.cortexhubs.com\")",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "expression": "concat(\"https://redwoodresearch.cortexhubs.com\", http.request.uri.path)"
          },
          "preserve_query_string": true
        }
      },
      "enabled": true
    }
  ]
}
