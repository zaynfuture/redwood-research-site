{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "redwood-api-gateway",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "routes": [
    {
      "pattern": "redwoodresearch.cortexhubs.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "redwood-api-gateway",
      "database_id": "8c755d87-cb6f-4edd-865f-61b27c767910",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "REDWOOD_API_UPSTREAM": "https://private-api.cortexhubs.com/query",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAErk-fcAQYCqFkKi",
    "TURNSTILE_EXPECTED_HOSTNAME": "redwoodresearch.cortexhubs.com",
    "STRIPE_INDIVIDUAL_PRICE_ID": "price_configure_in_stripe"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
